# Copy to .env at the repository root. Every process (web, worker, scripts) reads this one file.
# Visit /setup in the web app to see which settings are still missing (names only, never values).

# ---------------------------------------------------------------------------
# Database (required for the web app, worker, and scripts)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://academy:academy@localhost:5432/academy
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Sign-in with GitHub (Better Auth, using the GitHub App's OAuth client)
# ---------------------------------------------------------------------------
# Session encryption secret, 32+ characters: openssl rand -base64 33
AUTH_SECRET=
# GitHub App → "Client ID", and a secret from "Generate a new client secret"
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Where the app is reachable; callbacks go to <APP_BASE_URL>/api/auth/callback/github
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GitHub App (installation tokens and webhooks)
# ---------------------------------------------------------------------------
# Numeric App ID and the app's URL slug (github.com/apps/<slug>)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Contents of the generated .pem file. On one line, write newlines as \n.
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you set on the app, 16+ characters
GITHUB_APP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Concept mapping (worker). Leave CONCEPT_MAPPER_PROVIDER unset to disable it.
# ---------------------------------------------------------------------------
# claude-cli: runs your own signed-in Claude Code (`claude -p`) with every tool disabled, drawing
#   on your subscription's usage limits. Only for running the app for yourself (docs/decisions.md D21).
# anthropic: the Claude API with ANTHROPIC_API_KEY, billed per token.
# CONCEPT_MAPPER_PROVIDER=claude-cli
# Model alias or ID. Defaults: "sonnet" for claude-cli, "claude-sonnet-5" for anthropic.
# CONCEPT_MAPPER_MODEL=
# low | medium | high (default: medium)
# CONCEPT_MAPPER_EFFORT=medium
# CONCEPT_MAPPER_TIMEOUT_MS=300000
# CLAUDE_CLI_PATH=claude
# ANTHROPIC_API_KEY=
