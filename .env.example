# ---------------------------------------------------------------------------
# Milestones 0–1 (required to run the app, worker, and migrations locally)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://academy:academy@localhost:5432/academy
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Milestone 2 — GitHub identity + repository access (not used yet)
# ---------------------------------------------------------------------------
# Auth.js session encryption secret: `openssl rand -base64 33`
# AUTH_SECRET=
# GitHub App → "Client ID" / generated client secret (used for user sign-in)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# GitHub App numeric ID, slug, PEM private key, and webhook secret
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=
# Public base URL (callback + webhook targets), e.g. a tunnel in local dev
# APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Milestone 3 — model provider (not used yet)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
